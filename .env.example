# =============================================================================
# Creaciones Rahel — variables de entorno (PLANTILLA)
# Copia este archivo a .env.local y rellena los valores. NUNCA commitees .env*.
# Usa llaves DISTINTAS en preview y producción.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Base de datos (Postgres gestionado: Neon / Supabase) --------------------
# Prisma (0.2). URL con pooling para runtime + directa para migraciones.
DATABASE_URL="postgresql://user:password@host:5432/creaciones_rahel?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/creaciones_rahel?schema=public"

# --- Auth (NextAuth) — 0.3 ---------------------------------------------------
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Pagos: Mercado Pago (F1) ------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Pagos: Stripe (F1) ------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Pagos: PayPal (F1/F2) ---------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# --- Envíos: SkydropX / Envia.com (F1) ---------------------------------------
SHIPPING_PROVIDER="skydropx" # skydropx | envia
SKYDROPX_API_KEY=""
ENVIA_API_KEY=""

# --- Facturación CFDI: PAC (F1) ----------------------------------------------
INVOICE_PROVIDER="facturama" # facturama | swsapien
FACTURAMA_USER=""
FACTURAMA_PASSWORD=""
SWSAPIEN_TOKEN=""

# --- Correos: Resend (F1) ----------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Creaciones Rahel <no-reply@creacionesrahel.com>"

# --- Medios: Cloudflare R2 (F1) ----------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Rate limiting: Upstash (F1) ---------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Analítica y monitoreo ---------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- WhatsApp (botón F1; API en fase posterior) ------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="52..." # número en formato internacional sin +

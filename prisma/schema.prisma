// =============================================================================
// Creaciones Rahel — Esquema Prisma (Paso 0.2)
// Contempla TODO el alcance del CLAUDE.md (F1–F3). Se construye por fases, pero
// el modelo de datos existe completo desde el inicio.
//
// Convenciones:
//  - IDs: cuid() (String).
//  - Dinero: Decimal @db.Decimal(12,2) + campo `currency` (default MXN,
//    preparado para multimoneda). Los cálculos autoritativos son en servidor.
//  - i18n de contenido con SLUG/SEO (Product, Category, Collection, Page,
//    BlogPost) → tablas de traducción por locale.
//  - i18n de etiquetas cortas (atributos, personalización, materiales, medios)
//    → campo Json con forma { "es": "...", "en": "..." }.
//  - Historial/auditoría: registros inmutables (no se editan, se agregan).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductionType {
  IN_STOCK
  MADE_TO_ORDER
  ONE_OF_A_KIND
}

enum MediaType {
  IMAGE
  VIDEO
  VIDEO_360
  PROCESS_VIDEO
}

enum CustomizationInputType {
  TEXT
  SELECT
  DATE
}

enum PriceModifierType {
  FIXED
  PERCENT
}

enum AddressType {
  SHIPPING
  BILLING
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

// Máquina de estados COMERCIAL del pedido (sección 3.3).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

// Máquina de estados ARTESANAL de producción (sección 3.3), separada.
enum ProductionStatus {
  PENDING
  IN_PRODUCTION
  PERSONALIZATION
  QUALITY_CHECK
  FINISHED
  PACKED
  SHIPPED
  DELIVERED
}

enum PaymentProviderType {
  MERCADOPAGO
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum ShippingProviderType {
  SKYDROPX
  ENVIA
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESERVATION
  RELEASE
}

enum MaterialType {
  SILVER
  STEEL
  STONE
  CRYSTAL
  QUARTZ
  SEMIPRECIOUS
  BIJOUTERIE
  OTHER
}

enum MaterialUnit {
  GRAM
  PIECE
  CENTIMETER
}

enum MaterialMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  RETURN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum PointsMovementType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  ISSUED
  CANCELLED
  ERROR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SavedProductKind {
  FAVORITE
  WISHLIST
}

enum DomainEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// =============================================================================
// AUTENTICACIÓN (NextAuth) + ROLES
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credenciales; null si solo OAuth
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  customer Customer?

  // Acciones registradas como actor (STAFF/ADMIN).
  orderStatusChanges      OrderStatusHistory[]      @relation("OrderStatusActor")
  productionStatusChanges ProductionStatusHistory[] @relation("ProductionStatusActor")
  assignedProductions     ProductionOrder[]         @relation("ProductionAssignee")
  stockMovements          StockMovement[]           @relation("StockMovementActor")
  materialMovements       MaterialMovement[]        @relation("MaterialMovementActor")
  refundsRequested        Refund[]                  @relation("RefundRequestedBy")
  auditLogs               AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// CLIENTES, DIRECCIONES, DATOS FISCALES
// =============================================================================

model Customer {
  id               String   @id @default(cuid())
  userId           String?  @unique // null para invitados
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  locale           String   @default("es")
  acceptsMarketing Boolean  @default(false)
  // Métricas cacheadas (derivadas; se recalculan). Fuente de verdad: pedidos.
  ordersCount      Int      @default(0)
  totalSpent       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses         Address[]
  fiscalProfiles    FiscalData[]
  carts             Cart[]
  orders            Order[]
  savedProducts     SavedProduct[]
  reviews           Review[]
  pointsAccount     PointsAccount?
  pointsMovements   PointsMovement[]
  couponRedemptions CouponRedemption[]
  affiliate         Affiliate?

  @@index([email])
}

model Address {
  id           String      @id @default(cuid())
  customerId   String
  type         AddressType @default(SHIPPING)
  isDefault    Boolean     @default(false)
  name         String
  phone        String?
  street       String
  number       String?
  interior     String?
  neighborhood String?
  city         String
  state        String
  postalCode   String
  country      String      @default("MX")
  references   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model FiscalData {
  id         String   @id @default(cuid())
  customerId String?
  rfc        String
  legalName  String // razón social
  taxRegime  String // régimen fiscal
  cfdiUse    String // uso de CFDI
  postalCode String // C.P. fiscal
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([customerId])
}

// =============================================================================
// CATÁLOGO
// =============================================================================

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  imageKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryHierarchy")
  translations CategoryTranslation[]
  products     Product[]             @relation("ProductCategories")

  @@index([parentId])
}

model CategoryTranslation {
  id              String  @id @default(cuid())
  categoryId      String
  locale          String
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Collection {
  id         String   @id @default(cuid())
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  imageKey   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations CollectionTranslation[]
  products     Product[]               @relation("ProductCollections")
}

model CollectionTranslation {
  id              String  @id @default(cuid())
  collectionId    String
  locale          String
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@unique([locale, slug])
}

// Atributos facetados para filtros (material, piedra, color, …).
model Attribute {
  id       String @id @default(cuid())
  key      String @unique // "material" | "stone" | "color"
  label    Json // { es, en }
  position Int    @default(0)

  values AttributeValue[]
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String
  value       String // slug estable, p. ej. "plata"
  label       Json // { es, en }
  hexColor    String? // para atributo "color"

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  Product[] @relation("ProductAttributeValues")

  @@unique([attributeId, value])
}

model Product {
  id             String         @id @default(cuid())
  sku            String         @unique
  productionType ProductionType @default(IN_STOCK)
  status         ProductStatus  @default(DRAFT)
  basePrice      Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?       @db.Decimal(12, 2)
  currency       String         @default("MXN")
  productionDays Int            @default(0) // "Listo para enviar en X días"
  weightGrams    Int?
  isFeatured     Boolean        @default(false)
  isBestseller   Boolean        @default(false)
  nonReturnable  Boolean        @default(false) // personalizados no retornables
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  translations         ProductTranslation[]
  media                ProductMedia[]
  variants             ProductVariant[]
  categories           Category[]            @relation("ProductCategories")
  collections          Collection[]          @relation("ProductCollections")
  attributeValues      AttributeValue[]      @relation("ProductAttributeValues")
  customizationOptions CustomizationOption[]
  materials            ProductMaterial[]
  inventoryItems       InventoryItem[]
  stockReservations    StockReservation[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  savedBy              SavedProduct[]
  certificates         Certificate[]

  @@index([status])
  @@index([productionType])
  @@index([isFeatured])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String
  name             String
  slug             String
  shortDescription String?
  description      String?
  careInstructions String? // cuidado de piezas
  metaTitle        String?
  metaDescription  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  priceOverride Decimal? @db.Decimal(12, 2)
  weightGrams   Int?
  options       Json? // p. ej. { "talla": "18cm" }
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  media             ProductMedia[]
  inventoryItem     InventoryItem?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]
  materials         ProductMaterial[]

  @@index([productId])
}

model ProductMedia {
  id          String    @id @default(cuid())
  productId   String
  variantId   String?
  type        MediaType @default(IMAGE)
  storageKey  String // clave en R2; se sirve vía CDN/URL firmada
  alt         Json? // { es, en }
  position    Int       @default(0)
  isPrimary   Boolean   @default(false)
  isScaleShot Boolean   @default(false) // foto de escala (pieza puesta)
  createdAt   DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// Certificado de autenticidad por pieza (PDF, URL firmada con expiración).
model Certificate {
  id          String   @id @default(cuid())
  serial      String   @unique
  productId   String?
  orderItemId String?  @unique
  storageKey  String
  issuedAt    DateTime @default(now())

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// =============================================================================
// PERSONALIZACIÓN
// =============================================================================

model CustomizationOption {
  id                String                 @id @default(cuid())
  productId         String
  key               String // "grabado", "piedra", "fecha"
  inputType         CustomizationInputType
  label             Json // { es, en }
  required          Boolean                @default(false)
  maxLength         Int? // para grabado/texto
  position          Int                    @default(0)
  priceModifier     Decimal                @default(0) @db.Decimal(12, 2)
  priceModifierType PriceModifierType      @default(FIXED)
  timeModifierDays  Int                    @default(0)

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices                CustomizationChoice[]
  cartItemCustomizations CartItemCustomization[]

  @@unique([productId, key])
}

model CustomizationChoice {
  id                String            @id @default(cuid())
  optionId          String
  value             String // slug estable
  label             Json // { es, en }
  priceModifier     Decimal           @default(0) @db.Decimal(12, 2)
  priceModifierType PriceModifierType @default(FIXED)
  timeModifierDays  Int               @default(0)
  linkedMaterialId  String? // descuenta inventario de material al elegirse
  position          Int               @default(0)

  option                 CustomizationOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  linkedMaterial         Material?               @relation(fields: [linkedMaterialId], references: [id], onDelete: SetNull)
  cartItemCustomizations CartItemCustomization[]

  @@unique([optionId, value])
}

// =============================================================================
// INVENTARIO: productos terminados + materiales
// =============================================================================

model InventoryItem {
  id               String   @id @default(cuid())
  productId        String
  variantId        String?  @unique
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0) // alerta de stock bajo
  location         String?
  updatedAt        DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([productId, variantId])
  @@index([productId])
}

model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMovementType
  quantityDelta   Int
  reason          String?
  orderId         String?
  userId          String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user          User?         @relation("StockMovementActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
}

model Material {
  id             String       @id @default(cuid())
  code           String       @unique
  name           Json // { es, en }
  type           MaterialType
  unit           MaterialUnit @default(GRAM)
  quantityOnHand Decimal      @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal      @default(0) @db.Decimal(12, 3)
  unitCost       Decimal?     @db.Decimal(12, 2)
  supplier       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  movements            MaterialMovement[]
  productMaterials     ProductMaterial[]
  customizationChoices CustomizationChoice[]
}

model MaterialMovement {
  id            String               @id @default(cuid())
  materialId    String
  type          MaterialMovementType
  quantityDelta Decimal              @db.Decimal(12, 3)
  reason        String?
  orderItemId   String?
  userId        String?
  createdAt     DateTime             @default(now())

  material  Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user      User?      @relation("MaterialMovementActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([materialId])
}

// Lista de materiales (BOM) por producto/variante: consumo por pieza.
model ProductMaterial {
  id         String  @id @default(cuid())
  productId  String
  variantId  String?
  materialId String
  quantity   Decimal @db.Decimal(12, 3)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([materialId])
}

// Reserva de stock con expiración (crítica para ONE_OF_A_KIND; el bloqueo
// SELECT ... FOR UPDATE se hace a nivel de aplicación en checkout).
model StockReservation {
  id        String                 @id @default(cuid())
  productId String
  variantId String?
  quantity  Int                    @default(1)
  status    StockReservationStatus @default(ACTIVE)
  cartId    String?
  orderId   String?
  expiresAt DateTime
  createdAt DateTime               @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cart    Cart?           @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status, expiresAt])
}

// =============================================================================
// CARRITO
// =============================================================================

model Cart {
  id           String     @id @default(cuid())
  customerId   String?
  sessionToken String?    @unique // persistencia por cookie (invitados)
  status       CartStatus @default(ACTIVE)
  currency     String     @default("MXN")
  couponId     String?
  abandonedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon       Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        CartItem[]
  reservations StockReservation[]

  @@index([customerId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // cache de presentación; se recalcula en servidor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart           Cart                    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customizations CartItemCustomization[]

  @@index([cartId])
}

model CartItemCustomization {
  id         String    @id @default(cuid())
  cartItemId String
  optionId   String
  choiceId   String?
  textValue  String?
  dateValue  DateTime?

  cartItem CartItem             @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   CustomizationOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  choice   CustomizationChoice? @relation(fields: [choiceId], references: [id], onDelete: SetNull)

  @@index([cartItemId])
}

// =============================================================================
// PEDIDOS (estado comercial) + ITEMS + HISTORIAL
// =============================================================================

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  customerId            String?
  guestEmail            String?
  status                OrderStatus @default(PENDING_PAYMENT)
  currency              String      @default("MXN")
  region                String      @default("MX")
  subtotal              Decimal     @db.Decimal(12, 2)
  discountTotal         Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal         Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal              Decimal     @default(0) @db.Decimal(12, 2) // IVA
  grandTotal            Decimal     @db.Decimal(12, 2)
  couponId              String?
  couponCode            String?
  requiresInvoice       Boolean     @default(false)
  fiscalDataId          String?
  nonReturnableAccepted Boolean     @default(false) // checkbox personalizados
  shippingMethod        String?
  affiliateId           String?
  affiliateCode         String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  notes                 String?
  placedAt              DateTime    @default(now())
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon            Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  fiscalData        FiscalData?          @relation(fields: [fiscalDataId], references: [id], onDelete: SetNull)
  affiliate         Affiliate?           @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  addresses         OrderAddress[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  refunds           Refund[]
  shipment          Shipment?
  invoice           Invoice?
  pointsMovements   PointsMovement[]
  commission        AffiliateCommission?
  couponRedemption  CouponRedemption?
  reviews           Review[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
}

// Snapshot de direcciones del pedido (histórico, inmutable ante ediciones).
model OrderAddress {
  id           String      @id @default(cuid())
  orderId      String
  type         AddressType
  name         String
  phone        String?
  street       String
  number       String?
  interior     String?
  neighborhood String?
  city         String
  state        String
  postalCode   String
  country      String      @default("MX")
  references   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String // snapshot
  sku            String // snapshot
  unitPrice      Decimal        @db.Decimal(12, 2) // calculado en servidor
  quantity       Int
  lineTotal      Decimal        @db.Decimal(12, 2)
  productionType ProductionType
  nonReturnable  Boolean        @default(false)
  customization  Json? // snapshot de opciones elegidas
  createdAt      DateTime       @default(now())

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  production        ProductionOrder?
  certificate       Certificate?
  materialMovements MaterialMovement[]

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation("OrderStatusActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// =============================================================================
// PRODUCCIÓN (estado artesanal) — trazabilidad por pieza (OrderItem)
// =============================================================================

model ProductionOrder {
  id           String           @id @default(cuid())
  orderItemId  String           @unique
  status       ProductionStatus @default(PENDING)
  assignedToId String?
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  orderItem     OrderItem                 @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  assignedTo    User?                     @relation("ProductionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  statusHistory ProductionStatusHistory[]

  @@index([status])
}

model ProductionStatusHistory {
  id                String            @id @default(cuid())
  productionOrderId String
  fromStatus        ProductionStatus?
  toStatus          ProductionStatus
  note              String?
  userId            String?
  createdAt         DateTime          @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  user            User?           @relation("ProductionStatusActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([productionOrderId])
}

// =============================================================================
// PAGOS
// =============================================================================

model Payment {
  id           String              @id @default(cuid())
  orderId      String
  provider     PaymentProviderType
  providerRef  String? // id de la intención/preferencia en el proveedor
  status       PaymentStatus       @default(PENDING)
  amount       Decimal             @db.Decimal(12, 2)
  currency     String              @default("MXN")
  method       String? // card | oxxo | msi | apple_pay | ...
  installments Int? // meses sin intereses
  rawPayload   Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  paidAt       DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
}

// Idempotencia de webhooks (sección 7): un event_id procesado no se reprocesa.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String?
  payload     Json?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  paymentId     String?
  amount        Decimal      @db.Decimal(12, 2)
  status        RefundStatus @default(REQUESTED)
  providerRef   String?
  reason        String?
  requestedById String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// =============================================================================
// ENVÍOS
// =============================================================================

model Shipment {
  id             String               @id @default(cuid())
  orderId        String               @unique
  provider       ShippingProviderType
  carrier        String? // estafeta | dhl | fedex | correos
  service        String?
  trackingNumber String?
  labelKey       String? // guía en R2
  cost           Decimal?             @db.Decimal(12, 2)
  currency       String               @default("MXN")
  rateId         String?
  status         ShipmentStatus       @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
}

// =============================================================================
// FACTURACIÓN CFDI 4.0 (SAT)
// =============================================================================

model Invoice {
  id           String        @id @default(cuid())
  orderId      String        @unique
  status       InvoiceStatus @default(PENDING)
  provider     String? // facturama | swsapien
  uuid         String?       @unique // folio fiscal
  series       String?
  folio        String?
  // Snapshot de datos fiscales (inmutable).
  rfc          String
  legalName    String
  taxRegime    String
  cfdiUse      String
  postalCode   String
  subtotal     Decimal       @db.Decimal(12, 2)
  tax          Decimal       @db.Decimal(12, 2) // IVA
  total        Decimal       @db.Decimal(12, 2)
  currency     String        @default("MXN")
  xmlKey       String? // XML en R2
  pdfKey       String? // PDF en R2
  issuedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// =============================================================================
// CUPONES
// =============================================================================

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  value            Decimal    @default(0) @db.Decimal(12, 2)
  minSubtotal      Decimal?   @db.Decimal(12, 2)
  maxRedemptions   Int?
  redeemedCount    Int        @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String   @unique
  customerId String?
  createdAt  DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId])
}

// =============================================================================
// FIDELIZACIÓN (F2): puntos con ledger inmutable
// =============================================================================

model PointsAccount {
  id         String   @id @default(cuid())
  customerId String   @unique
  balance    Int      @default(0) // cache; fuente de verdad = suma del ledger
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PointsMovement {
  id         String             @id @default(cuid())
  customerId String
  type       PointsMovementType
  points     Int // con signo (+ acumula, - canjea)
  reason     String?
  orderId    String?
  expiresAt  DateTime?
  createdAt  DateTime           @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

// =============================================================================
// AFILIADOS (F2)
// =============================================================================

model Affiliate {
  id             String          @id @default(cuid())
  customerId     String?         @unique
  code           String          @unique
  name           String
  commissionRate Decimal         @db.Decimal(5, 4) // p. ej. 0.1000 = 10%
  status         AffiliateStatus @default(PENDING)
  payoutInfo     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders      Order[]
  commissions AffiliateCommission[]
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  orderId     String           @unique
  amount      Decimal          @db.Decimal(12, 2)
  rate        Decimal          @db.Decimal(5, 4)
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  paidAt      DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

// =============================================================================
// RESEÑAS (F2; modelo presente desde ahora)
// =============================================================================

model Review {
  id                 String       @id @default(cuid())
  productId          String
  customerId         String?
  orderId            String?
  rating             Int // 1..5 (validado en servidor)
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
}

// =============================================================================
// FAVORITOS / LISTA DE DESEOS
// =============================================================================

model SavedProduct {
  id         String           @id @default(cuid())
  customerId String
  productId  String
  kind       SavedProductKind @default(FAVORITE)
  createdAt  DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, kind])
  @@index([customerId])
}

// =============================================================================
// LEADS / NEWSLETTER
// =============================================================================

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("es")
  source         String?
  isConfirmed    Boolean   @default(false)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// =============================================================================
// CMS DE MARCA (páginas + blog), bilingüe
// =============================================================================

model Page {
  id          String   @id @default(cuid())
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations PageTranslation[]
}

model PageTranslation {
  id              String  @id @default(cuid())
  pageId          String
  locale          String
  slug            String
  title           String
  body            String? // rich text (HTML sanitizado)
  metaTitle       String?
  metaDescription String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model BlogPost {
  id          String    @id @default(cuid())
  coverKey    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations BlogPostTranslation[]
}

model BlogPostTranslation {
  id              String  @id @default(cuid())
  postId          String
  locale          String
  slug            String
  title           String
  excerpt         String?
  body            String? // rich text (HTML sanitizado)
  metaTitle       String?
  metaDescription String?

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
}

// =============================================================================
// OUTBOX (eventos de dominio) · AUDITORÍA · CONFIGURACIÓN
// =============================================================================

// Patrón outbox (sección 3.2): efectos secundarios confiables y reintentables.
model DomainEvent {
  id            String            @id @default(cuid())
  type          String // order.paid | order.shipped | production.status_changed | cart.abandoned
  aggregateType String?
  aggregateId   String?
  payload       Json
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  processedAt   DateTime?
  error         String?
  createdAt     DateTime          @default(now())

  @@index([status, availableAt])
}

// Registro de acciones sensibles en admin (sección 14): quién, qué, cuándo.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}

// Configuración de negocio editable (envío gratis mínimo, etc.).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
